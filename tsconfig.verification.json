{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/desktop/src/bridge.d.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "*.config.ts",
    "tests/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
