{
  "all": true,
  "src": ["packages", "apps"],
  "include": [
    "packages/**/*.ts",
    "apps/cli/src/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.cts"
  ],
  "exclude": ["**/*.d.ts", "apps/desktop/src/hooks/**", "apps/desktop/src/renderer/**"],
  "reporter": ["text", "html", "lcov", "json-summary"],
  "reports-dir": "coverage/backend",
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 75
}
